# AuthEase Environment Configuration

# MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/authease

# Base URL for verification and recovery links sent in emails
APP_BASE_URL=http://localhost:8080

# Demo Mode (true enables simulation controls, dev outbox, and seeds default accounts)
# Must NEVER be set to true in production
AUTHEASE_DEMO_MODE=true

# 256-bit AES Encryption Key (in hex) for encrypting TOTP secrets at rest
AUTHEASE_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional AI API key for plain language assist endpoint
AI_API_KEY=

# Optional SMTP Mail Server settings (if omitted, emails go to dev outbox)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Server HTTP Port
PORT=8080
